---
import { defaultLang, useTranslations } from "../i18n/utils";

const lang = defaultLang;
const _t = useTranslations(lang);
---

<Layout title="ReadAny - AI-Powered E-Book Reader">
  <Header lang={lang} t={_t} />
  <main>
    <Hero t={_t} />
    <FeatureShowcase t={_t} />
    <UseCases t={_t} />
    <TechStack t={_t} />
    <Download t={_t} />
    <FAQ t={_t} />
    <Community t={_t} />
  </main>
  <Footer t={_t} />
</Layout>
